{
  "name": "campo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces",
    "validate": "npm run validate -w @campo/tools",
    "migrate": "npm run migrate -w @campo/tools --",
    "calibrate": "npm run calibrate -w @campo/tools --",
    "apply": "npm run apply -w @campo/tools --",
    "editor": "npm run dev -w @campo/editor",
    "mobile": "npm run start -w @campo/mobile"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
