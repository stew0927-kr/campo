  "review": {
    "source": "기획에서 확인한 내용은 공구 목록부터 내 대여까지의 연결, 금요일·토요일 선택, 팝업에 표시할 정보입니다. 후속 검토 요청에 따라 팝업을 닫으면 날짜 선택으로 돌아가 방금 고른 날짜를 유지합니다. 재고 2대와 하루 3,000원은 예시입니다. 상세와 날짜 선택의 뒤로 가기, 날짜 선택 뒤 확인 버튼 표시를 검토용 UI로 보완했습니다.",
    "stateLabels": {"date": "선택한 날짜", "dateSelected": "날짜 선택 여부", "reservation": "예약 상태"},
    "requirements": [
      {"id": "open-drill", "group": "공구 찾기", "screen": "tools", "title": "전동 드릴 상세 열기", "expected": "공구 목록에서 전동 드릴을 누르면 상세가 열려요.", "action": "open-drill"},
      {"id": "read-details", "group": "공구 찾기", "screen": "drill", "title": "재고와 대여료 확인", "expected": "드릴 상세에 대여 가능 재고 2대와 하루 대여료 3,000원이 표시돼요."},
      {"id": "back-to-list", "group": "공구 찾기", "screen": "drill", "title": "상세에서 목록으로 돌아가기", "expected": "상세의 공구 목록 버튼을 누르면 원래 목록으로 돌아가요.", "action": "back-to-tools"},
      {"id": "open-date", "group": "날짜 선택", "screen": "drill", "title": "대여 날짜 화면 열기", "expected": "대여 날짜 선택을 누르면 날짜 선택 화면이 열려요.", "action": "choose-date"},
      {"id": "require-date", "group": "날짜 선택", "screen": "rental-date", "title": "날짜 선택 전 확인 버튼 숨김", "expected": "날짜를 고르기 전에는 대여 내용 확인 버튼이 보이지 않아요."},
      {"id": "set-friday", "group": "날짜 선택", "screen": "rental-date", "title": "금요일 선택", "expected": "금요일을 누르면 선택한 날짜가 금요일로 바뀌어요.", "action": "select-friday"},
      {"id": "set-saturday", "group": "날짜 선택", "screen": "rental-date", "title": "토요일로 변경", "expected": "토요일을 누르면 선택한 날짜가 토요일로 바뀌어요.", "action": "select-saturday"},
      {"id": "back-to-detail", "group": "날짜 선택", "screen": "rental-date", "title": "날짜 선택에서 상세로 돌아가기", "expected": "날짜 화면의 공구 상세 버튼을 누르면 전동 드릴 상세로 돌아가요.", "action": "back-to-drill"},
      {"id": "review-date", "group": "대여 확인과 복귀", "screen": "rental-date", "title": "선택한 공구와 날짜 확인", "expected": "선택한 날짜로 대여 확인 팝업을 열고, 팝업에 공구 이름과 선택한 날짜를 보여줘요.", "action": "review-rental"},
      {"id": "close-retains-date", "group": "대여 확인과 복귀", "screen": "rental-confirm", "title": "팝업 닫기 후 선택한 날짜 유지", "expected": "팝업을 닫으면 날짜 선택으로 돌아가고, 선택한 날짜와 확정 전 상태가 유지돼요.", "action": "close"},
      {"id": "confirm-rental", "group": "예약 완료와 조회", "screen": "rental-confirm", "title": "대여 예약 확정", "expected": "확정하면 예약 완료 화면이 열리고, 선택한 날짜와 예약 확정 상태가 유지돼요.", "action": "confirm-rental"},
      {"id": "view-rentals", "group": "예약 완료와 조회", "screen": "rental-complete", "title": "내 대여에서 확정 정보 확인", "expected": "내 대여에서 확정한 공구, 날짜, 예약 상태를 다시 볼 수 있어요.", "action": "open-my-rentals"}
    ],
