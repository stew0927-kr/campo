{
  "expo": {
    "name": "캠포",
    "slug": "campo",
    "version": "0.1.0",
    "scheme": "campo",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E4A84"
      },
      "package": "kr.campo.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "kr.hanyang.campo",
      "supportsTablet": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "캠퍼스 지도 위에 지금 계신 곳을 표시하고 길을 안내하기 위해 위치를 사용합니다. 위치는 안내가 끝나면 앱 안에서만 잠시 쓰고 서버로 보내지 않습니다.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "건물 안에서 몇 층에 계신지 기압으로 판단해 길을 안내하기 위해 기압 센서를 사용합니다. 기압 값은 두 지점 사이의 높이 차로만 쓰고 저장하지 않습니다."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E4A84"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dfd0831b-e863-4b35-becc-6c1e55069fa5"
      }
    }
  }
}
