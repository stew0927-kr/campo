{
  "name": "@campo/app",
  "version": "0.0.0",
  "private": true,
  "description": "Final user app (Expo, Android first). Starts as one empty screen on purpose: the five tabs are built by the front-end owner on top of @campo/core through the stable hooks in src/hooks.",
  "main": "index.ts",
  "scripts": {
    "bundle-campus": "node scripts/bundle-campus.mjs",
    "prestart": "npm run bundle-campus",
    "start": "expo start",
    "preandroid": "npm run bundle-campus",
    "android": "expo start --android",
    "eas-build-post-install": "npm run bundle-campus",
    "typecheck": "npm run bundle-campus --silent && tsc -p tsconfig.json",
    "export": "npm run bundle-campus && expo export --platform android",
    "build:development": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:production": "eas build --profile production --platform android",
    "submit:android": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@campo/core": "*",
    "@maplibre/maplibre-react-native": "11.5.1",
    "expo": "~58.0.25",
    "expo-dev-client": "~58.0.20",
    "expo-location": "~58.0.22",
    "expo-sensors": "~58.0.5",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/react": "~19.3.0"
  }
}
