{
  "name": "@campo/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Field survey app (Expo). Records points on site with the core edit engine and exports a survey file for the editor.",
  "main": "index.ts",
  "scripts": {
    "bundle-campus": "node scripts/bundle-campus.mjs",
    "prestart": "npm run bundle-campus",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export": "npm run bundle-campus && expo export --platform android",
    "typecheck": "npm run bundle-campus --silent && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@campo/core": "*",
    "expo": "~58.0.25",
    "expo-camera": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-sensors": "~58.0.5",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0"
  }
}
